<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Defi Cadran Companion"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vérification..."
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activer le Notification Listener" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Assistant"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/ha_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adresse (https://…)"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/ha_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jeton d'accès longue durée"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_ha_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enregistrer et connecter" />

        <TextView
            android:id="@+id/ha_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuiles de la montre"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Raccourcis : une entité par ligne, nom court facultatif après « | » (9 au plus)"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/tile_entities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="light.salon | Salon"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="4"
            android:fontFamily="monospace"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tuiles Modèle 1 à 4 : un modèle (template), ou un capteur dont l'attribut « texte » est affiché"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/tile_template_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Modèle 1 : sensor.montre_meteo ou {{ … }}"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/tile_template_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Modèle 2 : sensor.montre_meteo ou {{ … }}"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/tile_template_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Modèle 3 : sensor.montre_meteo ou {{ … }}"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/tile_template_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Modèle 4 : sensor.montre_meteo ou {{ … }}"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thermostat (climate)"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/tile_climate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="climate.cuisine"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_tiles_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enregistrer les tuiles" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ne pas restreindre la batterie" />

    </LinearLayout>
</ScrollView>

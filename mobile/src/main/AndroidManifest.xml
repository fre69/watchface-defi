<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lien avec Home Assistant (HaLink) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 15+ masque aux écouteurs les notifications jugées sensibles (codes, mais aussi
         des SMS ordinaires : « Contenu privé »). Accordée par le rôle compagnon de montre :
         adb shell cmd role add-role-holder android.app.role.COMPANION_DEVICE_WATCH com.defi.watchface.distance 0 -->
    <uses-permission android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS" />
    <!-- AdbWifiKeeper : rétablir le débogage sans fil coupé par une bascule entre les Wi-Fi
         de la maison (accordées par adb : pm grant …) ; la localisation sert à lire le nom du réseau -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:label="Defi Cadran Companion"
        android:allowBackup="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:theme="@style/Theme.AppCompat">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PhoneNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Réponses rapides et boutons d'alarme choisis sur la montre -->
        <service
            android:name=".ReplyListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/reply" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/action" />
            </intent-filter>
        </service>

        <!-- Commandes de la montre pour Home Assistant : tuiles Raccourcis et Liste, Assist, tuile affichée -->
        <service
            android:name=".HaCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/ha/action" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/ha/assist" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/ha/todo" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/ha/assist/new" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/ha/tiles/get" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/ha/climate" />
            </intent-filter>
        </service>

        <!-- Battement de cœur vers la montre, toutes les 15 min -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false" />
    </application>
</manifest>
